<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>会话管理原型</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f5f5f5;padding:20px}
.container{max-width:1600px;margin:0 auto;background:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1)}
.header{padding:20px 30px;border-bottom:1px solid #e0e0e0;display:flex;justify-content:space-between;align-items:center}
.header h1{font-size:24px;color:#333}
.btn{padding:8px 16px;border-radius:4px;border:none;cursor:pointer;font-size:14px;transition:.2s}
.btn-primary{background:#1976d2;color:#fff}
.btn-primary:hover{background:#1565c0}
.btn-secondary{background:#e0e0e0;color:#333;margin-right:8px}
.btn-secondary:hover{background:#d0d0d0}
.btn-text{background:transparent;color:#1976d2;padding:4px 8px}
.btn-text:hover{background:#f5f5f5}
.btn-small{padding:6px 12px;font-size:13px}
.content{padding:30px}
.dashboard{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:30px}
.stat-card{background:#f9f9f9;border-radius:6px;padding:20px;border-left:4px solid #1976d2}
.stat-card.warning{border-left-color:#ff9800}
.stat-value{font-size:32px;font-weight:bold;color:#333;margin-bottom:8px}
.stat-label{font-size:14px;color:#666}
.filters{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.filter-group{display:flex;align-items:center;gap:8px}
.filter-label{font-size:14px;color:#666}
.filter-select{padding:6px 12px;border:1px solid #ddd;border-radius:4px;font-size:14px}
.filter-select:focus{outline:none;border-color:#1976d2}
.search-box{flex:1;min-width:200px}
.search-input{width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:4px;font-size:14px}
.search-input:focus{outline:none;border-color:#1976d2}
.filter-tags{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;min-height:24px}
.filter-tag{background:#e3f2fd;color:#1565c0;padding:4px 12px;border-radius:16px;font-size:13px;display:flex;align-items:center;gap:6px}
.filter-tag .remove{cursor:pointer;font-weight:bold}
.session-list{display:flex;flex-direction:column;gap:12px}
.session-card{border:1px solid #e0e0e0;border-radius:6px;padding:20px;background:#fff;transition:.2s;position:relative;cursor:pointer}
.session-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.1)}
.session-card.selected{border-color:#1976d2;background:#f9fcff}
.status-bar{width:4px;position:absolute;left:0;top:0;bottom:0;border-radius:6px 0 0 6px}
.status-executing{background:#4caf50}
.status-waiting{background:#ff9800}
.status-interrupted{background:#f44336}
.status-closed{background:#9e9e9e}
.session-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.session-info{flex:1}
.session-title{font-size:16px;font-weight:500;color:#333;margin-bottom:8px}
.session-meta{font-size:13px;color:#666;margin-bottom:4px}
.session-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.badge{padding:3px 10px;border-radius:12px;font-size:12px;font-weight:500}
.badge-executing{background:#e8f5e9;color:#2e7d32}
.badge-waiting{background:#fff3e0;color:#e65100}
.badge-interrupted{background:#ffebee;color:#c62828}
.badge-closed{background:#f5f5f5;color:#757575}
.badge-attention{background:#ffebee;color:#c62828}
.badge-follow-up{background:#e3f2fd;color:#1565c0}
.session-actions{display:flex;gap:8px}
.session-content{margin-top:12px}
.session-goal{font-size:14px;color:#555;margin-bottom:8px}
.session-activity{font-size:13px;color:#888;padding:8px;background:#fafafa;border-radius:4px}
.modal{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center}
.modal.active{display:flex}
.modal-content{background:#fff;border-radius:8px;width:90%;max-width:500px;max-height:80vh;overflow-y:auto}
.modal-header{padding:20px;border-bottom:1px solid #e0e0e0;display:flex;justify-content:space-between;align-items:center}
.modal-title{font-size:18px;font-weight:500}
.modal-body{padding:20px}
.modal-footer{padding:16px 20px;border-top:1px solid #e0e0e0;display:flex;justify-content:flex-end;gap:8px}
.form-group{margin-bottom:16px}
.form-label{display:block;font-size:14px;color:#333;margin-bottom:6px}
.form-input,.form-textarea,.form-select{width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:4px;font-size:14px}
.form-textarea{resize:vertical;min-height:80px}
.form-input:focus,.form-textarea:focus,.form-select:focus{outline:none;border-color:#1976d2}
.form-hint{font-size:12px;color:#999;margin-top:4px}
.annotation{display:inline-block;background:#1976d2;color:#fff;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:500;margin-left:8px}
.toast{position:fixed;top:20px;right:20px;background:#323232;color:#fff;padding:12px 20px;border-radius:4px;box-shadow:0 4px 12px rgba(0,0,0,.3);z-index:2000;opacity:0;transition:opacity .3s}
.toast.show{opacity:1}
</style>
</head>
<body>
<div class="container">
<div class="header">
<h1>会话管理 <span class="annotation">原型2</span></h1>
<div>
<button class="btn btn-secondary" onclick="refreshSessions()">🔄 刷新</button>
<button class="btn btn-primary">⚙️ 设置</button>
</div>
</div>
<div class="content">
<div class="dashboard">
<div class="stat-card">
<div class="stat-value" id="stat-total">8</div>
<div class="stat-label">总会话数</div>
</div>
<div class="stat-card">
<div class="stat-value" id="stat-executing">2</div>
<div class="stat-label">执行中</div>
</div>
<div class="stat-card warning">
<div class="stat-value" id="stat-attention">3</div>
<div class="stat-label">需要介入</div>
</div>
<div class="stat-card">
<div class="stat-value" id="stat-followup">1</div>
<div class="stat-label">待跟进</div>
</div>
</div>

<div class="filters">
<div class="filter-group">
<span class="filter-label">运行状态:</span>
<select class="filter-select" id="filter-status" onchange="applyFilters()">
<option value="all">全部</option>
<option value="executing">执行中</option>
<option value="waiting">等待输入</option>
<option value="interrupted">已中断</option>
<option value="closed">已关闭</option>
</select>
</div>
<div class="filter-group">
<span class="filter-label">关注状态:</span>
<select class="filter-select" id="filter-attention" onchange="applyFilters()">
<option value="all">全部</option>
<option value="needs">需要介入</option>
<option value="follow">待跟进</option>
<option value="no">无需关注</option>
</select>
</div>
<div class="filter-group">
<span class="filter-label">Agent:</span>
<select class="filter-select" id="filter-agent" onchange="applyFilters()">
<option value="all">全部</option>
<option value="codex">Codex Desktop</option>
<option value="opencode">OpenCode Server</option>
</select>
</div>
<div class="search-box">
<input type="text" class="search-input" id="search-input" placeholder="搜索标题、目标、项目..." oninput="applyFilters()">
</div>
</div>

<div class="filter-tags" id="filter-tags"></div>

<div class="session-list" id="session-list"></div>
</div>
</div>

<div class="modal" id="modal-followup">
<div class="modal-content">
<div class="modal-header">
<h2 class="modal-title">标记为待跟进</h2>
<button class="btn btn-secondary" onclick="closeModal('modal-followup')">✕</button>
</div>
<div class="modal-body">
<div class="form-group">
<label class="form-label">标签</label>
<input type="text" class="form-input" id="followup-tags" placeholder="待测试, 需讨论, 优先级高">
<div class="form-hint">最多5个标签，用逗号分隔</div>
</div>
<div class="form-group">
<label class="form-label">备注说明</label>
<textarea class="form-textarea" id="followup-notes" placeholder="添加跟进原因或说明..."></textarea>
</div>
<div class="form-group">
<label class="form-label">提醒时间</label>
<select class="form-select" id="followup-reminder">
<option value="">不设置提醒</option>
<option value="1h">1小时后</option>
<option value="3h">3小时后</option>
<option value="tomorrow">明天上午9:00</option>
<option value="nextweek">下周一上午9:00</option>
</select>
</div>
</div>
<div class="modal-footer">
<button class="btn btn-secondary" onclick="closeModal('modal-followup')">取消</button>
<button class="btn btn-primary" onclick="saveFollowUp()">保存</button>
</div>
</div>
</div>

<div class="modal" id="modal-ignore">
<div class="modal-content">
<div class="modal-header">
<h2 class="modal-title">忽略中断</h2>
<button class="btn btn-secondary" onclick="closeModal('modal-ignore')">✕</button>
</div>
<div class="modal-body">
<div class="form-group">
<label class="form-label">忽略原因</label>
<select class="form-select" id="ignore-reason">
<option value="resolved">问题已自行解决</option>
<option value="obsolete">任务已过期</option>
<option value="duplicate">重复的会话</option>
<option value="test">测试会话</option>
<option value="other">其他原因</option>
</select>
</div>
<div class="form-group">
<label class="form-label">补充说明</label>
<textarea class="form-textarea" id="ignore-notes" placeholder="添加补充说明（可选）"></textarea>
</div>
</div>
<div class="modal-footer">
<button class="btn btn-secondary" onclick="closeModal('modal-ignore')">取消</button>
<button class="btn btn-primary" onclick="saveIgnore()">确认忽略</button>
</div>
</div>
</div>

<div class="toast" id="toast"></div>

<script>
const sessions = [
  {id: 1, title: '重构用户认证模块', agent: 'codex', agentName: 'Codex Desktop', project: '~/project/auth-system', status: 'executing', attention: 'no', goal: '实现 JWT token 刷新机制', activity: '正在编辑 auth.service.ts', activityType: 'editing', updateTime: '5分钟前'},
  {id: 2, title: '修复数据库连接池问题', agent: 'opencode', agentName: 'OpenCode Server', project: '~/project/api-backend', status: 'waiting', attention: 'needs', goal: '调整连接池配置参数', activity: '需要确认最大连接数配置', activityType: 'waiting', updateTime: '2小时前'},
  {id: 3, title: '优化前端性能', agent: 'codex', agentName: 'Codex Desktop', project: '~/project/web-app', status: 'interrupted', attention: 'follow', goal: '减少首屏加载时间', activity: '构建失败 - webpack配置错误', activityType: 'error', updateTime: '1天前'},
  {id: 4, title: '修复登录页样式', agent: 'codex', agentName: 'Codex Desktop', project: '~/project/web-app', status: 'closed', attention: 'no', goal: '调整登录按钮位置和颜色', activity: '样式已更新并提交', activityType: 'completed', updateTime: '3天前'},
  {id: 5, title: '实现数据导出功能', agent: 'opencode', agentName: 'OpenCode Server', project: '~/project/data-platform', status: 'executing', attention: 'no', goal: '支持 CSV 和 Excel 格式导出', activity: '正在生成导出文件', activityType: 'processing', updateTime: '10分钟前'},
  {id: 6, title: '升级依赖包版本', agent: 'codex', agentName: 'Codex Desktop', project: '~/project/mobile-app', status: 'waiting', attention: 'needs', goal: '升级 React Native 到最新版本', activity: '需要解决兼容性问题', activityType: 'waiting', updateTime: '4小时前'},
  {id: 7, title: 'API 文档生成', agent: 'opencode', agentName: 'OpenCode Server', project: '~/project/api-backend', status: 'interrupted', attention: 'needs', goal: '自动生成 OpenAPI 文档', activity: '生成工具配置错误', activityType: 'error', updateTime: '6小时前'},
  {id: 8, title: '添加单元测试', agent: 'codex', agentName: 'Codex Desktop', project: '~/project/utils-lib', status: 'closed', attention: 'no', goal: '提升测试覆盖率到80%', activity: '测试已完成并通过', activityType: 'completed', updateTime: '2天前'}
];

let currentSessionId = null;

function renderSessions() {
  const listEl = document.getElementById('session-list');
  listEl.innerHTML = sessions.map(s => {
    const statusClass = `status-${s.status}`;
    const statusText = {executing: '执行中', waiting: '等待输入', interrupted: '已中断', closed: '已关闭'}[s.status];
    const badges = [`<span class="badge badge-${s.status}">${statusText}</span>`];
    if (s.attention === 'needs') badges.push('<span class="badge badge-attention">需要介入</span>');
    if (s.attention === 'follow') badges.push('<span class="badge badge-follow-up">待跟进</span>');
    const activityIcon = {editing: '💬', waiting: '⏸️', error: '❌', completed: '✅', processing: '⚙️'}[s.activityType] || '📝';
    const actionButtons = s.status === 'closed' ? `<button class="btn btn-secondary btn-small" onclick="openSession(${s.id})">👁️ 查看</button>` : `<button class="btn btn-primary btn-small" onclick="openSession(${s.id})">▶️ 打开</button>${s.status !== 'executing' ? `<button class="btn btn-text btn-small" onclick="event.stopPropagation();showFollowUpModal(${s.id})">⭐ 跟进</button>` : ''}${s.status === 'interrupted' ? `<button class="btn btn-text btn-small" onclick="event.stopPropagation();showIgnoreModal(${s.id})">🚫 忽略</button>` : ''}`;
    return `<div class="session-card" data-id="${s.id}" data-status="${s.status}" data-attention="${s.attention}" data-agent="${s.agent}" onclick="selectSession(${s.id})"><div class="status-bar ${statusClass}"></div><div class="session-header"><div class="session-info"><div class="session-title">${s.title}</div><div class="session-meta">${s.agentName} | ${s.project}</div><div class="session-meta">更新: ${s.updateTime}</div><div class="session-badges">${badges.join('')}</div></div><div class="session-actions">${actionButtons}</div></div><div class="session-content"><div class="session-goal">📌 目标: ${s.goal}</div><div class="session-activity">${activityIcon} ${s.activityType === 'waiting' || s.activityType === 'error' ? '等待' : '活动'}: ${s.activity}</div></div></div>`;
  }).join('');
}

function selectSession(id) {
  currentSessionId = id;
  document.querySelectorAll('.session-card').forEach(card => card.classList.toggle('selected', parseInt(card.dataset.id) === id));
}

function openSession(id) {
  const session = sessions.find(s => s.id === id);
  showToast(`正在打开会话: ${session.title}`);
  setTimeout(() => showToast(`会话已在 ${session.agentName} 中打开`), 800);
}

function refreshSessions() {
  showToast('正在刷新会话列表...');
  setTimeout(() => {renderSessions(); updateStats(); showToast('刷新完成');}, 1000);
}

function showFollowUpModal(id) {
  currentSessionId = id;
  document.getElementById('followup-tags').value = '';
  document.getElementById('followup-notes').value = '';
  document.getElementById('followup-reminder').value = '';
  document.getElementById('modal-followup').classList.add('active');
}

function saveFollowUp() {
  const session = sessions.find(s => s.id === currentSessionId);
  if (session) {session.attention = 'follow'; renderSessions(); updateStats();}
  closeModal('modal-followup');
  showToast('已标记为待跟进');
}

function showIgnoreModal(id) {
  currentSessionId = id;
  document.getElementById('ignore-reason').value = 'resolved';
  document.getElementById('ignore-notes').value = '';
  document.getElementById('modal-ignore').classList.add('active');
}

function saveIgnore() {
  const session = sessions.find(s => s.id === currentSessionId);
  if (session) {session.attention = 'no'; renderSessions(); updateStats();}
  closeModal('modal-ignore');
  showToast('已忽略该中断');
}

function closeModal(modalId) {
  document.getElementById(modalId).classList.remove('active');
}

function applyFilters() {
  const status = document.getElementById('filter-status').value;
  const attention = document.getElementById('filter-attention').value;
  const agent = document.getElementById('filter-agent').value;
  const search = document.getElementById('search-input').value.toLowerCase();
  document.querySelectorAll('.session-card').forEach(card => {
    const cardStatus = card.dataset.status, cardAttention = card.dataset.attention, cardAgent = card.dataset.agent, cardText = card.textContent.toLowerCase();
    let show = true;
    if (status !== 'all' && cardStatus !== status) show = false;
    if (attention !== 'all' && cardAttention !== attention) show = false;
    if (agent !== 'all' && cardAgent !== agent) show = false;
    if (search && !cardText.includes(search)) show = false;
    card.style.display = show ? 'block' : 'none';
  });
  updateFilterTags();
}

function updateFilterTags() {
  const tagsEl = document.getElementById('filter-tags'), tags = [];
  const status = document.getElementById('filter-status'), attention = document.getElementById('filter-attention'), agent = document.getElementById('filter-agent');
  if (status.value !== 'all') tags.push(`<div class="filter-tag">运行状态: ${status.options[status.selectedIndex].text} <span class="remove" onclick="clearFilter('filter-status')">×</span></div>`);
  if (attention.value !== 'all') tags.push(`<div class="filter-tag">关注状态: ${attention.options[attention.selectedIndex].text} <span class="remove" onclick="clearFilter('filter-attention')">×</span></div>`);
  if (agent.value !== 'all') tags.push(`<div class="filter-tag">Agent: ${agent.options[agent.selectedIndex].text} <span class="remove" onclick="clearFilter('filter-agent')">×</span></div>`);
  tagsEl.innerHTML = tags.join('');
}

function clearFilter(filterId) {
  document.getElementById(filterId).value = 'all';
  applyFilters();
}

function updateStats() {
  const stats = {total: sessions.length, executing: sessions.filter(s => s.status === 'executing').length, attention: sessions.filter(s => s.attention === 'needs').length, followup: sessions.filter(s => s.attention === 'follow').length};
  document.getElementById('stat-total').textContent = stats.total;
  document.getElementById('stat-executing').textContent = stats.executing;
  document.getElementById('stat-attention').textContent = stats.attention;
  document.getElementById('stat-followup').textContent = stats.followup;
}

function showToast(message) {
  const toast = document.getElementById('toast');
  toast.textContent = message;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2000);
}

renderSessions();
updateStats();
</script>
</body>
</html>